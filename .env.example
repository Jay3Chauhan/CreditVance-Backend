# ==============================================================================
# Credit Card Smart Advisor & Ingestion Service - Environment Configuration
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
APP_NAME="Credit Card Smart Advisor API"
APP_VERSION="1.0.0"
DEBUG=true

# Host & Port Binding
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (Comma-separated or * for development)
# For production Flutter mobile app: set specific origins or *
CORS_ORIGINS=["*"]

# ------------------------------------------------------------------------------
# Database Configuration (Neon PostgreSQL Serverless)
# ------------------------------------------------------------------------------
# Example Neon async connection string (using asyncpg):
# DATABASE_URL=postgresql+asyncpg://neondb_owner:YOUR_PASSWORD@ep-xyz-pooler.ap-southeast-1.aws.neon.tech/neondb?ssl=require
# Local fallback (for offline development/tests):
DATABASE_URL=sqlite+aiosqlite:///./credit_cards.db
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30

# ------------------------------------------------------------------------------
# Redis Cache & Lock Configuration (Upstash Redis)
# ------------------------------------------------------------------------------
# Upstash provides standard Redis URL (rediss://default:YOUR_PASSWORD@xyz.upstash.io:6379)
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true
REDIS_CACHE_TTL_SECONDS=3600
REDIS_SYNC_LOCK_TTL_SECONDS=7200

# ------------------------------------------------------------------------------
# Security & JWT Authentication
# ------------------------------------------------------------------------------
# Generate a secure 256-bit key: openssl rand -hex 32
JWT_SECRET_KEY=change-me-super-secret-hex-key-for-jwt-tokens-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# Admin API Key for triggering manual ingestion sync
ADMIN_API_KEY=admin-secret-sync-key-change-me

# ------------------------------------------------------------------------------
# Third-Party Ingestion Service (SaveSage Club)
# ------------------------------------------------------------------------------
SAVESAGE_API_BASE_URL=https://api.savesage.club
SAVESAGE_WEB_BASE_URL=https://savesage.club
CRAWLER_CONCURRENCY=5
CRAWLER_REQUEST_DELAY_SECONDS=0.25
CRAWLER_MAX_RETRIES=3
CRAWLER_TIMEOUT_SECONDS=15

# Scheduled Background Sync (Cron Expression)
# Default: Runs every Sunday at 02:00 AM UTC ("0 2 * * 0")
CRON_SYNC_ENABLED=true
CRON_SYNC_SCHEDULE="0 2 * * 0"
